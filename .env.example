# Firebase Web configuration; fill these values in local .env.local.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=hyperdatalab-27172.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=hyperdatalab-27172
NEXT_PUBLIC_FIREBASE_APP_ID=1:447478305426:web:dc4da6493ede5afaed8c4b
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=447478305426

# Cloudflare Worker URL; the Worker owns R2 access and private GROBID routing.
NEXT_PUBLIC_R2_WORKER_URL=http://localhost:8787

# Development-only demo switch. Demo identities must exist in Firebase Auth.
NEXT_PUBLIC_ENABLE_QUICK_LOGIN=false

# Firebase Admin seed only. The default key location is %USERPROFILE%\.firebase\hyperdatalab-27172-service-account.json.
# Keep the service-account JSON private and untracked; set this only to override the default path.
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_SEED_CONFIRM_PROJECT=hyperdatalab-27172
FIREBASE_SEED_PASSWORD=
