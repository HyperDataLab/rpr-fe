# Firebase Web configuration; fill these values in local .env.local.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# Cloudflare Worker URL; the Worker owns authenticated R2 file access.
NEXT_PUBLIC_R2_WORKER_URL=http://localhost:8787
NEXT_PUBLIC_GOOGLE_WORKSPACE_DOMAIN=hyperdatalab.org

# Public GROBID service used to extract manuscript metadata from uploaded PDFs.
NEXT_PUBLIC_GROBID_URL=https://grobid.hyperdatalab.org

# Development-only demo switch. Demo identities must exist in Firebase Auth.
NEXT_PUBLIC_ENABLE_QUICK_LOGIN=false

# Firebase Admin seed only. Save the service-account JSON outside the repository.
# Keep the service-account JSON private and untracked; set this only to override the default path.
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_SEED_CONFIRM_PROJECT=
FIREBASE_SEED_PASSWORD=
