{
  "name": "hyperdata-preprint-public-fe",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3003",
    "build": "next build",
    "start": "next start -p 3003",
    "lint": "next lint",
    "seed": "node --env-file=.env.local scripts/seed-firebase-users.mjs",
    "seed:firebase-users": "npm run seed",
    "seed:workspace-admin": "node --env-file=.env.local scripts/seed-workspace-admin.mjs",
    "worker:dev": "npx --yes wrangler@4.160.1 dev --config worker/wrangler.toml --port 8787",
    "worker:test": "vitest run --config worker/vitest.config.mts",
    "worker:migrate:remote": "npx --yes wrangler@4.160.1 d1 migrations apply researchpulse-workspace --remote --config worker/wrangler.toml",
    "worker:deploy": "npx --yes wrangler@4.160.1 deploy --config worker/wrangler.toml",
    "worker:tail": "npx --yes wrangler@4.160.1 tail --config worker/wrangler.toml"
  },
  "dependencies": {
    "@hyperdata/design-system": "file:./packages/design-system",
    "@tanstack/react-query": "^5.103.1",
    "@tanstack/react-query-devtools": "^5.103.1",
    "firebase": "^13.2.0",
    "lenis": "^1.3.26",
    "next": "15.5.7",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-pdf": "^11.0.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.8.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "firebase-admin": "^14.5.0",
    "typescript": "^5.7.2",
    "vitest": "^5.1.0"
  }
}
